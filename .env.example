# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Evolution API v2 ----
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE=geprek

# Public URL of this backend, used by the webhook registration helper.
WEBHOOK_URL=http://localhost:3000/webhook
# Optional shared secret. If set, requests must send ?secret=... or x-webhook-secret.
WEBHOOK_SECRET=

# ---- LLM (OpenAI-compatible: OpenAI, DeepSeek, Groq, ...) ----
LLM_API_KEY=
# Leave empty for OpenAI. Examples:
#   DeepSeek: https://api.deepseek.com
#   Groq:     https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ---- Admin ----
# Comma-separated WhatsApp numbers allowed to send admin commands (#resume).
ADMIN_NUMBERS=
# Where handover notifications are sent. Defaults to the first ADMIN_NUMBERS entry.
ADMIN_NOTIFY_NUMBER=
