[TEMPLATE]
# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Evolution API v2 ----
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE=geprek

# Public URL of this backend, used by the webhook registration helper.
WEBHOOK_URL=http://localhost:3000/webhook
# Optional shared secret. If set, requests must send ?secret=... or x-webhook-secret.
WEBHOOK_SECRET=

# ---- Redis (session, cart, dedupe, handover) ----
# Use redis://redis:6379 when the backend runs inside the compose network.
REDIS_URL=redis://localhost:6379
# Idle lifetime of a customer session in seconds (default 1800 = 30 minutes).
SESSION_TTL_SECONDS=1800

# ---- LLM (OpenAI-compatible) ----
# Pick ONE provider block below and copy the values into LLM_API_KEY,
# LLM_BASE_URL, and LLM_MODEL.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# DeepSeek
#   LLM_API_KEY=sk-...                 (https://platform.deepseek.com)
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat

# OpenAI
#   LLM_API_KEY=sk-...                 (https://platform.openai.com)
#   LLM_BASE_URL=
#   LLM_MODEL=gpt-4o-mini

# Groq
#   LLM_API_KEY=gsk_...                (https://console.groq.com)
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile

# Google Gemini (OpenAI-compatible endpoint)
#   LLM_API_KEY=AIza...                (https://aistudio.google.com)
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.0-flash

# ---- Admin ----
# Comma-separated WhatsApp numbers allowed to send admin commands (#status, #resume).
ADMIN_NUMBERS=
# Where handover notifications and confirmed order receipts are sent.
# Defaults to the first ADMIN_NUMBERS entry.
ADMIN_NOTIFY_NUMBER=
